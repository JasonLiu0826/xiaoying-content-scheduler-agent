# Offline mock requires no configuration. These variables are for --model live.
# BASE_URL includes /v1 when your provider requires it.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_API_KEY=
# Per HTTP request; finite retries are recorded separately from agent decisions.
MODEL_TIMEOUT_MS=30000
MODEL_MAX_RETRIES=1
